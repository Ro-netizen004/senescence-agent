# Python virtual environment
venv/
venv*/
env/
paper/
presentation/
poster/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables (never commit API keys)
.env
*.env

# Data files (too large for git)
backend/data/*.h5ad
backend/data/*.h5
backend/data/*.csv
backend/data/uploads/

# Validation data (large downloads)
*.tar
*.tar.gz
data/gse226225/

# Gene sets and reference data (small, keep in repo)
!backend/data/*.json

# Generated outputs
backend/outputs/

# Raw evaluation runs stay local or in a versioned research archive. Keep
# protocols, seed lists, manifests, and aggregate summaries in Git.
eval/results/ablation/*seed*.json
eval/results/ablation/*seed*.log
eval/results/**/raw/
eval/results/**/*.zip
eval/results/**/*.tar.zst

# Human-annotation working files remain private until both labels are frozen.
eval/ablation/annotation/blinded_key.json
eval/ablation/annotation/blinded_replies.csv
eval/ablation/annotation/blinded_replies_annotator_*.csv
eval/ablation/annotation/blinded_replies_annotator_*.xlsx

# OS files
.DS_Store
Thumbs.db

# VS Code
.vscode/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Distribution / packaging
dist/
build/
*.egg-info/

# Node modules (for React frontend later)
node_modules/
frontend/build/
